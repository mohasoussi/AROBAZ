---
import { MODULE1, leconUrl } from "../data/module1";
const { actif } = Astro.props as { actif?: string };
---
<nav class="mnav" aria-label="Leçons du module 1">
  <a href="/espace/ia-business/module-1/" class="mtitle">
    <span class="small muted">IA & Business · Module 1</span>
    <strong>{MODULE1.titre}</strong>
  </a>
  <div class="bar"><span data-module-bar></span></div>
  <ol>
    {MODULE1.lecons.map((l) => (
      <li>
        <a href={leconUrl(l)} aria-current={actif === l.slug ? "page" : undefined} data-statut={`ia-business/${l.slug}`}>
          <span class="st" aria-hidden="true">{l.numero}</span>
          <span>{l.titre}</span>
        </a>
      </li>
    ))}
    <li>
      <a href="/espace/ia-business/module-1/validation/" aria-current={actif === "validation" ? "page" : undefined} data-statut-module="ia-business/module-1">
        <span class="st" aria-hidden="true">✓</span>
        <span>Validation du module</span>
      </a>
    </li>
  </ol>
</nav>
<script>
  import { lire } from "../scripts/progress";
  const e = lire();
  const liens = [...document.querySelectorAll<HTMLAnchorElement>(".mnav [data-statut]")];
  let faites = 0;
  liens.forEach((a) => {
    if (e.lecons[a.dataset.statut!]?.terminee) {
      a.classList.add("fait");
      faites++;
    }
  });
  const m = document.querySelector<HTMLAnchorElement>(".mnav [data-statut-module]");
  if (m && e.modules[m.dataset.statutModule!]?.valide) m.classList.add("fait");
  const bar = document.querySelector<HTMLElement>("[data-module-bar]");
  if (bar) bar.style.width = `${Math.round((faites / liens.length) * 100)}%`;
</script>
<style>
  .mnav { position: sticky; top: 96px; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px; }
  .mtitle { display: grid; text-decoration: none; color: var(--ink); margin-bottom: 0.8rem; font-family: var(--f-title); line-height: 1.3; }
  ol { list-style: none; padding: 0; margin: 1rem 0 0; }
  li + li { margin-top: 2px; }
  ol a { display: flex; gap: 0.7rem; align-items: flex-start; padding: 0.55rem 0.6rem; border-radius: 8px; text-decoration: none; color: var(--ink-2); font-size: 0.93rem; line-height: 1.35; }
  ol a:hover { background: var(--bg); color: var(--ink); }
  ol a[aria-current="page"] { background: var(--blue-soft); color: var(--blue-ink); font-weight: 600; }
  .st { flex: none; width: 24px; height: 24px; border-radius: 50%; border: 1.5px solid var(--line-2); display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; color: var(--muted); }
  a.fait .st { background: var(--mint); border-color: var(--mint); color: #fff; font-size: 0; }
  a.fait .st::after { content: "✓"; font-size: 0.8rem; }
  @media (max-width: 960px) { .mnav { position: static; } }
</style>
