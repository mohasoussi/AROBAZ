---
const { inverse = false } = Astro.props as { inverse?: boolean };
---
<a href="/" class="logo" aria-label="AROBAZ, accueil">
  <img src={inverse ? "/logo/arobaz-logo-blanc.svg" : "/logo/arobaz-logo-bleu.svg"} alt="AROBAZ" height="28" />
</a>
<style>
  .logo { display: inline-flex; align-items: center; text-decoration: none; }
  .logo img { display: block; height: 28px; width: auto; }
</style>
