---
import "../styles/global.css";
import "../styles/motion.css";
import "../styles/couleur.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
type Props = { title: string; description?: string; noindex?: boolean; bare?: boolean };
const { title, description = "AROBAZ : apprenez à utiliser l'IA et les outils numériques pour créer vous-même votre projet, votre activité et votre communication.", noindex = false, bare = false } = Astro.props;
const fullTitle = title === "AROBAZ" ? "AROBAZ · Apprenez. Créez. Lancez-vous." : `${title} · AROBAZ`;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="AROBAZ" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/og-default.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AROBAZ : Apprenez. Créez. Lancez-vous." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1E40AF" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a href="#contenu" class="skip">Aller au contenu</a>
    <Header />
    <main id="contenu"><slot /></main>
    {!bare && <Footer />}
    <script>import "../scripts/motion";</script>
  </body>
</html>
<style is:global>
  .skip { position: absolute; left: -9999px; top: 8px; background: var(--ink); color: #fff; padding: 8px 12px; border-radius: 8px; z-index: 100; }
  .skip:focus { left: 8px; }
</style>
