---
import BaseLayout from "../layouts/BaseLayout.astro";
import { FORMATIONS, METHODE } from "../data/formations";
import { TOUTES_LECONS, MODULES } from "../data/curriculum";
const total = FORMATIONS.reduce((n, f) => n + f.modules.length, 0);
---
<BaseLayout title="AROBAZ">
  <!-- 1. Hero éditorial -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">Formations IA & numérique · en autonomie</span>
        <h1 class="titre-hero"><span class="ln"><span>Apprenez.</span></span><span class="ln"><span>Créez.</span></span><span class="ln"><span class="accent">Lancez-vous.</span></span></h1>
        <p class="lead">
          AROBAZ vous apprend à utiliser l'IA et les outils numériques pour créer vous-même votre projet, votre activité et votre communication.
          Sans être développeur, designer ou expert en marketing.
        </p>
        <div class="actions">
          <a href="/espace/ia-business/module-1/" class="btn btn-primary">Commencer le module 1 gratuitement</a>
          <a href="/formations/" class="btn btn-ghost">Voir les formations</a>
        </div>
        <p class="small muted">Accès libre pendant la phase de démonstration · aucune inscription · aucun prérequis</p>
      </div>

      <div class="hero-visual demo" aria-label="Démonstration animée : écrire une demande claire à l'IA avec la méthode C.O.C.C.F., puis vérifier le résultat">
        <div class="demo-card card" data-demo>
          <div class="demo-top">
            <span class="tag">Méthode C.O.C.C.F.</span>
            <span class="small muted">Une demande claire à l'IA</span>
          </div>
          <ol class="demo-lines">
            <li><b>C</b><span><em>Contexte</em>Je lance une boutique de plantes d'intérieur.</span></li>
            <li><b>O</b><span><em>Objectif</em>Écrire ma page d'accueil.</span></li>
            <li><b>C</b><span><em>Cible</em>Des débutants qui oublient d'arroser.</span></li>
            <li><b>C</b><span><em>Contraintes</em>Ton chaleureux, sans jargon.</span></li>
            <li><b>F</b><span><em>Format</em>Un titre et trois bénéfices.</span></li>
          </ol>
          <div class="demo-send" aria-hidden="true"><span class="btn btn-primary btn-sm">Envoyer à l'IA</span></div>
          <div class="demo-result" aria-hidden="true">
            <span class="small muted">Exemple de réponse</span>
            <p class="r-titre">Des plantes qui vivent, enfin.</p>
            <ul>
              <li>Faciles, même sans la main verte</li>
              <li>Un suivi d'entretien inclus</li>
              <li>Livrées prêtes à poser</li>
            </ul>
          </div>
          <div class="demo-verif" aria-hidden="true"><span>Utiliser</span><i>›</i><span>Vérifier</span><i>›</i><span>Décider</span></div>
        </div>
        <p class="demo-legende small muted">C'est la méthode que vous apprenez dans le module 1 : donner à l'IA les cinq informations qui font la différence, puis toujours vérifier avant de décider.</p>
      </div>
    </div>
  </section>

  <!-- 2. Bande de marque -->
  <section class="band" aria-label="Ce que vous apprendrez à créer">
    <div class="marquee">
      <div class="track">
        <div class="grp"><span>Sites internet</span><i>·</i><span>E-commerce</span><i>·</i><span>Applications</span><i>·</i><span>Automatisations</span><i>·</i><span>Réseaux sociaux</span><i>·</i><span>Vidéo</span><i>·</i><span>Contenu</span><i>·</i></div>
        <div class="grp" aria-hidden="true"><span>Sites internet</span><i>·</i><span>E-commerce</span><i>·</i><span>Applications</span><i>·</i><span>Automatisations</span><i>·</i><span>Réseaux sociaux</span><i>·</i><span>Vidéo</span><i>·</i><span>Contenu</span><i>·</i></div>
      </div>
    </div>
  </section>

  <!-- 3. Méthode -->
  <section class="section paper">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">La méthode AROBAZ</span>
        <h2>On ne retient vraiment que ce qu'on a fait soi-même.</h2>
        <p class="lead">Chaque leçon suit le même rythme en cinq temps. Pas de théorie qui s'accumule : une notion, une démonstration, et tout de suite la pratique sur votre propre projet.</p>
      </div>
      <ol class="methode">
        {METHODE.map((m, i) => (
          <li>
            <span class="num">{String(i + 1).padStart(2, "0")}</span>
            <h3>{m.etape}</h3>
            <p>{m.texte}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. Formations -->
  <section class="section">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Les formations</span>
        <h2>Deux parcours complets pour lancer et faire connaître votre activité.</h2>
      </div>
      <div class="grid grid-2">
        {FORMATIONS.map((f) => (
          <a href={`/formations/${f.slug}/`} class={`card formation ${f.couleur}`}>
            <span class={`tag ${f.couleur === "coral" ? "tag-coral" : ""}`}>{f.modules.length} modules · Débutant</span>
            <h3>{f.titre}</h3>
            <p class="muted">{f.accroche}</p>
            <ul>
              {f.modules.slice(0, 5).map((m) => <li>{m.titre}</li>)}
              <li class="more">+ {f.modules.length - 5} autres modules</li>
            </ul>
            <span class="go">Découvrir le programme →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Chiffres -->
  <section class="section-tight ink-bg">
    <div class="wrap stats">
      <div><strong>{FORMATIONS.length}</strong><span>parcours complets</span></div>
      <div><strong>{total}</strong><span>modules au programme</span></div>
      <div><strong>0</strong><span>prérequis technique</span></div>
      <div><strong>{TOUTES_LECONS.length}</strong><span>leçons disponibles dès maintenant</span></div>
    </div>
  </section>

  <!-- 6. Comment ça marche -->
  <section class="section paper">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Comment ça marche</span>
        <h2>Vous avancez seul, mais jamais sans repères.</h2>
      </div>
      <div class="grid grid-4 how">
        <div><span class="n">1</span><h3>Vous regardez</h3><p class="muted">Des vidéos courtes, une notion à la fois, avec de vraies démonstrations à l'écran.</p></div>
        <div><span class="n">2</span><h3>Vous pratiquez</h3><p class="muted">Un exercice et un prompt prêt à l'emploi, appliqués directement à votre projet.</p></div>
        <div><span class="n">3</span><h3>Vous validez</h3><p class="muted">Une grille de vérification et un quiz par leçon, puis un quiz de validation par module.</p></div>
        <div><span class="n">4</span><h3>Vous construisez</h3><p class="muted">Module après module, votre projet prend forme : à la fin, il est en ligne.</p></div>
      </div>
      <p class="center"><a href="/comment-ca-marche/" class="btn btn-ghost">En savoir plus</a></p>
    </div>
  </section>

  <!-- 7. Catalogue -->
  <section class="section">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Catalogue</span>
        <h2>Ce qui est disponible, et ce qui arrive.</h2>
      </div>
      <div class="grid grid-3">
        <a class="card cat" href="/espace/ia-business/module-1/">
          <span class="tag tag-mint">Disponible · accès libre</span>
          <h3>Module 1 · Comprendre l'IA</h3>
          <p class="muted">{MODULES[0].lecons.length} leçons, exercices, prompts et quiz de validation. Votre premier assistant IA à la clé.</p>
        </a>
        <a class="card cat" href="/formations/ia-business/">
          <span class="tag tag-mint">Disponible · lecture et exercices</span>
          <h3>IA & Business · parcours complet</h3>
          <p class="muted">{MODULES.length} modules, {TOUTES_LECONS.length} leçons : identité, site, e-commerce, application, automatisations, lancement. Les vidéos arrivent leçon après leçon.</p>
        </a>
        <a class="card cat" href="/formations/contenu-reseaux-sociaux/">
          <span class="tag tag-coral">En préparation</span>
          <h3>Contenu & Réseaux sociaux</h3>
          <p class="muted">Stratégie, visuels, vidéos au téléphone, CapCut, IA vidéo et conversion.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- 8. CTA -->
  <section class="section-tight">
    <div class="wrap">
      <div class="cta">
        <div>
          <h2>Votre premier assistant IA, dès aujourd'hui.</h2>
          <p>Le module 1 est en accès libre, comme le reste du parcours pendant la phase de démonstration. En une à deux heures, vous comprenez l'IA, vous savez lui parler, et vous repartez avec un assistant configuré pour votre projet.</p>
        </div>
        <a href="/espace/ia-business/module-1/" class="btn btn-light">Commencer maintenant</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: clamp(48px, 8vw, 104px) 0 clamp(56px, 8vw, 96px); }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } }
  .accent { color: var(--blue); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 2rem 0 1rem; }

  .hero { position: relative; overflow: hidden; }
  .hero::before, .hero::after { content: ""; position: absolute; z-index: -1; border-radius: 50%; filter: blur(70px); opacity: 0.55; pointer-events: none; }
  .hero::before { width: 520px; height: 520px; left: -140px; top: -120px; background: radial-gradient(circle, #c7d6ff, transparent 70%); animation: derive 16s ease-in-out infinite alternate; }
  .hero::after { width: 480px; height: 480px; right: -120px; bottom: -160px; background: radial-gradient(circle, #e2cbff, transparent 70%); animation: derive 20s ease-in-out infinite alternate-reverse; }
  @keyframes derive { to { transform: translate(60px, 40px) scale(1.12); } }
  .hero .wrap { position: relative; }

  .titre-hero .ln { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .titre-hero .ln > span { display: inline-block; transform: translateY(110%); animation: monte 0.95s var(--ease) forwards; }
  .titre-hero .ln:nth-child(1) > span { animation-delay: 0.1s; }
  .titre-hero .ln:nth-child(2) > span { animation-delay: 0.28s; }
  .titre-hero .ln:nth-child(3) > span { animation-delay: 0.46s; }
  @keyframes monte { to { transform: none; } }

  .hero-visual { position: relative; }
  .demo-card { padding: 22px 22px 20px; position: relative; overflow: hidden; min-height: 440px; }
  .demo-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; gap: 8px; flex-wrap: wrap; }
  .demo-lines { list-style: none; padding: 0; margin: 0; display: grid; gap: 9px; transition: opacity 0.5s, transform 0.6s var(--ease), max-height 0.6s var(--ease); max-height: 400px; }
  .demo-lines li { margin: 0; display: flex; gap: 12px; align-items: flex-start; padding: 9px 12px; border-radius: 12px; background: var(--bg); border: 1px solid var(--line); opacity: 0; transform: translateX(-14px); transition: opacity 0.5s, transform 0.6s var(--ease), background-color 0.4s, border-color 0.4s; }
  .demo-lines li.on { opacity: 1; transform: none; }
  .demo-lines b { flex: none; width: 30px; height: 30px; border-radius: 9px; background: var(--blue); color: #fff; display: grid; place-items: center; font-family: var(--f-title); font-weight: 800; font-size: 0.95rem; transform: scale(0.6); transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .demo-lines li.on b { transform: scale(1); }
  .demo-lines li:nth-child(2) b { background: var(--mint); }
  .demo-lines li:nth-child(4) b { background: #8a1fff; }
  .demo-lines span { font-size: 0.93rem; color: var(--ink); line-height: 1.4; }
  .demo-lines em { display: block; font-style: normal; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .demo-send { display: flex; justify-content: flex-end; margin-top: 14px; opacity: 0; transform: translateY(8px); transition: opacity 0.4s, transform 0.5s var(--ease); }
  .demo-send.on { opacity: 1; transform: none; }
  .demo-send.press .btn { transform: scale(0.94); box-shadow: 0 0 0 8px rgb(36 87 230 / 0.18); }
  .demo-send .btn { transition: transform 0.2s, box-shadow 0.4s; }
  .demo-result { position: absolute; left: 22px; right: 22px; top: 70px; padding: 18px 20px; border-radius: 14px; background: linear-gradient(135deg, #1b2a52, #2457e6); color: #fff; opacity: 0; transform: translateY(24px) scale(0.97); pointer-events: none; transition: opacity 0.6s, transform 0.7s var(--ease); }
  .demo-result .small { color: #c7d6ff; }
  .demo-result.on { opacity: 1; transform: none; }
  .r-titre { font-family: var(--f-title); font-weight: 800; font-size: 1.45rem; letter-spacing: -0.02em; margin: 0.3rem 0 0.8rem; color: #fff; }
  .demo-result ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .demo-result li { margin: 0; padding-left: 28px; position: relative; font-size: 0.95rem; opacity: 0; transform: translateX(-10px); transition: opacity 0.5s, transform 0.5s var(--ease); }
  .demo-result li::before { content: "✓"; position: absolute; left: 0; top: 0; width: 20px; height: 20px; border-radius: 50%; background: var(--mint); display: grid; place-items: center; font-size: 0.75rem; font-weight: 800; }
  .demo-result.on li { opacity: 1; transform: none; }
  .demo-result.on li:nth-child(1) { transition-delay: 0.5s; } .demo-result.on li:nth-child(2) { transition-delay: 0.8s; } .demo-result.on li:nth-child(3) { transition-delay: 1.1s; }
  .demo-verif { position: absolute; left: 22px; right: 22px; bottom: 20px; display: flex; gap: 10px; align-items: center; justify-content: center; font-family: var(--f-title); font-weight: 700; font-size: 0.9rem; opacity: 0; transition: opacity 0.4s; }
  .demo-verif.on { opacity: 1; }
  .demo-verif span { padding: 7px 14px; border-radius: 999px; border: 1.5px solid var(--line-2); color: var(--ink-2); transition: background-color 0.4s, color 0.4s, border-color 0.4s; }
  .demo-verif span.ok { background: var(--mint); border-color: var(--mint); color: #fff; }
  .demo-verif i { color: var(--muted); font-style: normal; }
  .demo-card.fin .demo-lines { opacity: 0.0; transform: translateY(-10px); }
  .demo-card.fin .demo-send { opacity: 0; }
  .demo-legende { margin: 14px 4px 0; max-width: 34em; }

  .band { border-block: 1px solid var(--line); background: var(--paper); overflow: hidden; }
  .marquee { padding-block: 20px; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .track { display: flex; width: max-content; animation: defile 34s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  .grp { display: flex; gap: 1.4rem; padding-right: 1.4rem; font-family: var(--f-title); font-weight: 700; font-size: 1.15rem; color: var(--ink-2); white-space: nowrap; }
  .grp i { color: var(--line-2); font-style: normal; }
  @keyframes defile { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; flex-wrap: wrap; justify-content: center; width: auto; } .grp[aria-hidden] { display: none; } .grp { flex-wrap: wrap; justify-content: center; } }

  .head { max-width: 760px; margin-bottom: clamp(32px, 5vw, 56px); }
  .methode { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; counter-reset: none; }
  @media (max-width: 1000px) { .methode { grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); } }
  .methode li { margin: 0; padding: 24px 20px; border-radius: var(--radius); background: var(--bg); border: 1px solid var(--line); }
  .methode .num { font-family: var(--f-title); font-weight: 800; color: var(--blue); font-size: 0.85rem; }
  .methode h3 { margin: 0.6rem 0 0.4rem; }
  .methode p { font-size: 0.95rem; color: var(--ink-2); margin: 0; }

  .formation { border-top: 4px solid var(--blue); }
  .formation.coral { border-top-color: var(--coral); }
  .formation h3 { font-size: 1.55rem; margin: 1rem 0 0.5rem; }
  .formation ul { list-style: none; padding: 0; margin: 1.25rem 0; border-top: 1px solid var(--line); }
  .formation li { margin: 0; padding: 0.6rem 0; border-bottom: 1px solid var(--line); font-size: 0.95rem; color: var(--ink-2); }
  .formation .more { color: var(--muted); border-bottom: 0; }
  .go { font-family: var(--f-title); font-weight: 700; color: var(--blue); }
  .formation.coral .go { color: var(--coral-ink); }

  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; text-align: center; }
  @media (max-width: 720px) { .stats { grid-template-columns: 1fr 1fr; } }
  .stats strong { display: block; font-family: var(--f-title); font-size: clamp(2.4rem, 5vw, 3.4rem); font-weight: 800; color: #fff; letter-spacing: -0.04em; }
  .stats span { color: #9ca3af; font-size: 0.95rem; }

  .how .n { display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--blue-soft); color: var(--blue); font-family: var(--f-title); font-weight: 800; margin-bottom: 0.8rem; }
  .center { text-align: center; margin-top: 2.5rem; }

  .cat h3 { margin-top: 1rem; }

  .cta { background: var(--blue); color: #fff; border-radius: 20px; padding: clamp(28px, 5vw, 56px); display: flex; gap: 32px; align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .cta h2 { color: #fff; margin-bottom: 0.4em; }
  .cta p { color: #dbe5ff; max-width: 40em; margin: 0; }
</style>
